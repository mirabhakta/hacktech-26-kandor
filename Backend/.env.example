# Kandor backend environment variables.
# Copy to Backend/.env and fill in only the providers you want to use.

# Provider selection: auto | rules | k2 | gemini
KANDOR_PROVIDER=rules

# Gemini / Gemma (optional; requires a Google AI Studio key)
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# K2 Think V2 (optional; requires IFM/K2 credentials)
K2_API_KEY=
IFM_API_KEY=
K2_API_URL=https://api.k2think.ai/v1/chat/completions
K2_MODEL=MBZUAI-IFM/K2-Think-v2
K2_TIMEOUT_SECONDS=20

# Server
KANDOR_HOST=0.0.0.0
KANDOR_PORT=8000
KANDOR_RELOAD=false

# Security / abuse protection
KANDOR_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
KANDOR_ALLOWED_ORIGIN_REGEX=chrome-extension://.*
KANDOR_RATE_LIMIT_PER_MINUTE=120
KANDOR_MAX_REQUEST_BYTES=2097152
KANDOR_MAX_ANALYSIS_TEXT_CHARS=20000