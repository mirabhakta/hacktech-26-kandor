{
  "manifest_version": 3,
  "name": "kandor",
  "version": "0.1.0",
  "description": "Scans supported social pages and sends content to your child-safety evaluation backend.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["storage", "tabs", "alarms", "cookies"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.instagram.com/*",
    "https://*.discord.com/*",
    "https://web.whatsapp.com/*",
    "https://*.messenger.com/*",
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "kandor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "https://*.instagram.com/*",
        "https://*.discord.com/*",
        "https://web.whatsapp.com/*",
        "https://*.messenger.com/*",
        "https://*.facebook.com/*"
      ],
      "js": ["constants.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
